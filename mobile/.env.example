# Copy to .env.local and fill in.
# Tardy website (paid verification checkout lives at $EXPO_PUBLIC_TARDY_WEB_URL/verify).
EXPO_PUBLIC_TARDY_WEB_URL=
# Tardy API server (Rust backend), e.g. https://api.tardy.dev. Set it to talk to the real
# server over HTTP; leave it empty to run on the in-app mock backend (and its dev sign-in).
EXPO_PUBLIC_TARDY_API_URL=
