# Non-secret runtime configuration.
DATABASE_URL=postgresql://localhost/tardy_dev
TARDY_BIND=127.0.0.1:3300
TARDY_PUBLIC_BASE_URL=http://127.0.0.1:3300
TARDY_WEB_BASE_URL=http://127.0.0.1:8787

# Stripe secrets. Copy this file to .env.local; never commit the populated file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Connect FPL. OIDC client credentials and activation key are server-only bindings.
# Leave CLIENT_ID unset to disable linking. Register the exact callback in FPL Auth.
# TARDY_FPL_OIDC_CLIENT_ID=
# TARDY_FPL_OIDC_CLIENT_SECRET=
# TARDY_FPL_OIDC_CALLBACK_URL=https://api.tardy.news/v1/mcp-bridges/fpl/callback
# TARDY_FPL_BRIDGE_SIGNING_SECRET=
# TARDY_FPL_BRIDGE_URL=https://mcp.fpl.dev
STRIPE_REAL_TARDY_PRICE_ID=price_1UM06o6805BvilhV8dvcLRAP
STRIPE_SUPER_TARDY_PRICE_ID=price_1UM06q6805BvilhV3xBBAFXV

# For local webhook delivery:
# stripe listen --forward-to http://127.0.0.1:3300/v1/web/billing/stripe/webhook
# Put the printed whsec_... value in STRIPE_WEBHOOK_SECRET.
