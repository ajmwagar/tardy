{
  "version": 1,
  "pipelines": [
    {
      "id": "public-site",
      "watchPaths": [
        ".fab/",
        "agent/llms.txt",
        "web/public/"
      ],
      "pipeline": {
        "type": "static_site",
        "installCommand": "true",
        "buildCommand": "mkdir -p dist && cp -R web/public/. dist/ && cp agent/llms.txt dist/llms.txt && cp skills/tardy/SKILL.md dist/SKILL.md",
        "publishDir": "dist",
        "framework": "static"
      }
    },
    {
      "id": "api-image",
      "watchPaths": [
        ".fab/",
        "Cargo.toml",
        "Cargo.lock",
        "Dockerfile",
        "src/",
        "ingest/",
        "migrations/",
        "policies/",
        "vendor/"
      ],
      "pipeline": {
        "type": "oci_image",
        "registry": "registry.fpl.dev",
        "image": "tardy",
        "context": ".",
        "dockerfile": "Dockerfile",
        "tags": [
          "candidate"
        ],
        "push": true,
        "tlsVerify": true,
        "rootfsPublish": true,
        "rootfsName": "tardy",
        "secretEnv": {
          "SHROUD_ARTIFACT_ACCESS_KEY_ID": "r2-artifact-access-key-id",
          "SHROUD_ARTIFACT_SECRET_ACCESS_KEY": "r2-artifact-secret-access-key",
          "SHROUD_ARTIFACT_ENDPOINT": "r2-artifact-endpoint",
          "SHROUD_ARTIFACT_BUCKET": "r2-artifact-bucket",
          "SHROUD_ARTIFACT_REGION": "r2-artifact-region"
        }
      }
    }
  ]
}
